; Inno Setup script for ShinyForge (installs per-user, no admin rights needed).
; One file: the Pokedex tracker spreadsheets (~2.2 GB together) are NOT inside the setup - they are downloaded from
; ShinyForge's GitHub page during the installation (only the ones the user doesn't have yet, each checked against its
; SHA-256). The list is generated by build.ps1 into dist\sheets_files.iss.
#define AppName "ShinyForge"
#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif
#define Publish "..\dist\publish"
#define SheetsUrl "https://github.com/Domsanna/ShinyForge/releases/download/spreadsheets-1/"

[Setup]
AppId={{6F3C2A6E-9B1D-4E2B-8C59-5F1D7B0A2C11}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher=ShinyForge
AppPublisherURL=https://github.com/Domsanna/ShinyForge
AppVerName={#AppName} {#AppVersion}
VersionInfoVersion={#AppVersion}
CloseApplications=yes
RestartApplications=yes
DefaultDirName={localappdata}\Programs\{#AppName}
DefaultGroupName={#AppName}
PrivilegesRequired=lowest
OutputDir=..\dist
OutputBaseFilename=ShinyForge-Setup
SetupIconFile=..\ShinyForge\Assets\ShinyForge.ico
UninstallDisplayIcon={app}\ShinyForge.exe
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

[Tasks]
Name: "sheets"; Description: "Download the Pokedex tracker spreadsheets (about 2.2 GB in total - only the ones you don't have yet)"; GroupDescription: "Pokedex trackers:"
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Shortcuts:"

[Files]
Source: "{#Publish}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "portable.flag"

[Dirs]
; Never removed on uninstall (the user's files): the Backup Tools folder and the spreadsheets (your progress).
Name: "{userdocs}\ShinyForge\Backup Tools"; Flags: uninsneveruninstall
Name: "{userdocs}\ShinyForge\Spreadsheets"; Flags: uninsneveruninstall

[Messages]
FinishedLabel=ShinyForge is installed.%n%nPokedex tracker spreadsheets: Documents\ShinyForge\Spreadsheets (picked automatically for the game you choose). A tracker that wasn't downloaded can be downloaded later from the game's page in ShinyForge.%n%nBackup Tools folder: Documents\ShinyForge\Backup Tools%nIf ShinyForge can't find a program it needs (FFmpeg, PKHeX, SysBot, 3DS Capture, Python...) on this PC, it looks in that folder.

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\ShinyForge.exe"
Name: "{group}\ShinyForge User Guide"; Filename: "{app}\ShinyForge User Guide.html"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
Name: "{group}\ShinyForge Backup Tools folder"; Filename: "{userdocs}\ShinyForge\Backup Tools"
Name: "{group}\ShinyForge Spreadsheets"; Filename: "{userdocs}\ShinyForge\Spreadsheets"
Name: "{userdesktop}\{#AppName}"; Filename: "{app}\ShinyForge.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\ShinyForge.exe"; Description: "Launch ShinyForge"; Flags: nowait postinstall skipifsilent

[Code]
var
  DownloadPage: TDownloadWizardPage;
  SheetNames, SheetTargets: TArrayOfString;

function OnDownloadProgress(const Url, FileName: String; const Progress, ProgressMax: Int64): Boolean;
begin
  Result := True;
end;

procedure InitializeWizard;
begin
  DownloadPage := CreateDownloadPage('Pokedex tracker spreadsheets',
    'Downloading the trackers from ShinyForge''s GitHub page (each file is checked). You can skip this - they can also be downloaded later inside ShinyForge.',
    @OnDownloadProgress);
end;

{ Queues one tracker unless the user already has it (their progress is never overwritten). }
procedure AddSheet(const Name, Rel, Sha: String);
var
  Target: String;
  N: Integer;
begin
  Target := ExpandConstant('{userdocs}\ShinyForge\Spreadsheets\') + Rel;
  if FileExists(Target) then
    Exit;
  DownloadPage.Add('{#SheetsUrl}' + Name, Name, Sha);
  N := GetArrayLength(SheetNames);
  SetArrayLength(SheetNames, N + 1);
  SetArrayLength(SheetTargets, N + 1);
  SheetNames[N] := Name;
  SheetTargets[N] := Target;
end;

#include "..\dist\sheets_files.iss"

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (CurPageID <> wpReady) or not WizardIsTaskSelected('sheets') then
    Exit;
  DownloadPage.Clear;
  SetArrayLength(SheetNames, 0);
  SetArrayLength(SheetTargets, 0);
  AddSheets;
  if GetArrayLength(SheetNames) = 0 then
    Exit;
  DownloadPage.Show;
  try
    try
      DownloadPage.Download;
    except
      if not DownloadPage.AbortedByUser then
        SuppressibleMsgBox(AddPeriod(GetExceptionMessage) + #13#10#13#10 +
          'ShinyForge will still be installed. The trackers that were downloaded are kept; the others can be downloaded later from the game''s page in ShinyForge.',
          mbInformation, MB_OK, IDOK);
    end;
  finally
    DownloadPage.Hide;
  end;
end;

{ Moves the downloaded trackers from the temporary folder into Documents\ShinyForge\Spreadsheets. }
procedure CurStepChanged(CurStep: TSetupStep);
var
  I: Integer;
  Src: String;
begin
  if CurStep <> ssPostInstall then
    Exit;
  for I := 0 to GetArrayLength(SheetNames) - 1 do
  begin
    Src := ExpandConstant('{tmp}\') + SheetNames[I];
    if FileExists(Src) and not FileExists(SheetTargets[I]) then
    begin
      ForceDirectories(ExtractFileDir(SheetTargets[I]));
      if not CopyFile(Src, SheetTargets[I], True) then
        Log('Could not copy ' + Src + ' to ' + SheetTargets[I]);
    end;
  end;
end;
